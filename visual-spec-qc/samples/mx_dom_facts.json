{
  "_note": "真實案例:由 Browser MCP 對 https://bizdev.medialand.com.tw/demo/2021_02_MX_website/#/about (視窗 1440 寬) 抽出的實際 getComputedStyle。",
  "url": "https://bizdev.medialand.com.tw/demo/2021_02_MX_website/#/about",
  "nodes": [
    {
      "selector": "section.sec-title h1.d-none.d-lg-block",
      "computed": {
        "color": "rgb(33, 37, 41)",
        "fontSize": "48px",
        "fontWeight": "700",
        "fontFamily": "Noto Sans TC"
      }
    },
    {
      "selector": "section.sec-title .breadcrumbs",
      "computed": {
        "color": "rgb(199, 0, 103)",
        "fontSize": "14px",
        "fontWeight": "400"
      }
    },
    {
      "selector": "section.sec-subtitle h2.new-t2",
      "computed": {
        "color": "rgb(33, 37, 41)",
        "fontSize": "36px",
        "fontWeight": "700"
      }
    },
    {
      "selector": "section.sec-seo h2.new-t2.text-center",
      "computed": {
        "color": "rgb(33, 37, 41)",
        "fontSize": "36px",
        "fontWeight": "700"
      }
    },
    {
      "selector": "section.sec-seo .border-radius-20px.bg-white h3.new-t3",
      "computed": {
        "color": "rgba(0, 0, 0, 0)",
        "fontSize": "28px",
        "fontWeight": "700"
      }
    },
    {
      "selector": "section.sec-seo .border-radius-20px.bg-white",
      "computed": {
        "backgroundColor": "rgb(255, 255, 255)",
        "borderRadius": "20px"
      }
    },
    {
      "selector": "span.iso-quote",
      "computed": {
        "color": "rgb(0, 93, 145)",
        "fontSize": "16px",
        "fontWeight": "400"
      }
    },
    {
      "selector": ".footer-item-title",
      "computed": {
        "color": "rgb(159, 160, 160)",
        "fontSize": "16px",
        "fontWeight": "400"
      }
    }
  ]
}
